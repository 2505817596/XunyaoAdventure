@page "/gacha"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject GameConfigStore Configs

<PageTitle>聚妖台</PageTitle>

<main class="gacha-page">
    <section class="gacha-panel">
        @if (_account is null)
        {
            <div class="gacha-stage state-only">
                <div class="gacha-heading">
                    <h1>聚妖台</h1>
                </div>
                <div class="gacha-empty-state">请先登录</div>
                <button class="gacha-primary-action" @onclick="GoLogin">返回登录</button>
            </div>
        }
        else if (_account.Profile is null)
        {
            <div class="gacha-stage state-only">
                <div class="gacha-heading">
                    <h1>聚妖台</h1>
                </div>
                <div class="gacha-empty-state">请先创建角色</div>
                <button class="gacha-primary-action" @onclick="GoCreateCharacter">创建角色</button>
            </div>
        }
        else if (!_pools.Any())
        {
            <div class="gacha-stage state-only">
                <div class="gacha-heading">
                    <h1>聚妖台</h1>
                </div>
                <div class="gacha-empty-state">后台还没有配置奖池</div>
                <button class="gacha-primary-action" @onclick="GoHome">返回主页</button>
            </div>
        }
        else
        {
            <header class="gacha-topbar">
                <div class="gacha-top-level">等级:@_account.Level</div>
                <div class="gacha-top-resource power"><span>池</span><b>@_pools.Count</b></div>
                <div class="gacha-top-resource coin"><span>钱</span><b>@_account.Copper</b></div>
                <div class="gacha-top-resource gem"><span>战</span><b>@TotalPower</b></div>
                <button class="gacha-settings" aria-label="设置" disabled>!</button>
            </header>

            <div class="gacha-stage">
                <div class="gacha-heading">
                    <h1>聚妖台</h1>
                </div>

                <div class="gacha-currency">
                    <span>铜钱</span>
                    <b>@_account.Copper</b>
                </div>

                <div class="gacha-pools">
                    @foreach (GachaPoolConfig pool in _pools)
                    {
                        <button class="gacha-pool" @onclick="() => GoPool(pool.Id)">
                            <b>@pool.Name</b>
                            <small>@pool.Description</small>
                            <span>@ResolveCostText(pool)</span>
                        </button>
                    }
                </div>
            </div>

            <footer class="gacha-bottom-bar">
                <button class="gacha-back" @onclick="GoHome">返回</button>
                <button class="active">聚妖</button>
                <button disabled>奖池</button>
                <button disabled>召唤</button>
            </footer>
        }
    </section>
</main>

@code {
    private PlayerAccount? _account;
    private List<GachaPoolConfig> _pools = new();

    private int TotalPower
        => _account?.Monsters.Sum(monster => monster.Power) ?? 0;

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        _pools = Configs.GetGachaPools().ToList();
    }

    private void GoPool(string poolId)
        => Navigation.NavigateTo($"/gacha/{Uri.EscapeDataString(poolId)}");

    private string ResolveCostText(GachaPoolConfig pool)
    {
        ConsumableTemplateConfig? item = Configs.GetConsumableTemplates()
            .FirstOrDefault(template => string.Equals(template.TemplateId, pool.CostItemTemplateId, StringComparison.OrdinalIgnoreCase));
        return $"{item?.Name ?? "抽卡道具"} / 抽";
    }

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoHome()
        => Navigation.NavigateTo("/");
}
