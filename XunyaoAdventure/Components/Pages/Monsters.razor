@page "/monsters"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject QuestStore Quests

<PageTitle>妖怪</PageTitle>

<main class="monster-page">
    <section class="monster-panel">
        @if (_account is null)
        {
            <div class="wap-line">请先登录</div>
            <button class="wap-button" @onclick="GoLogin">返回登录</button>
        }
        else if (_account.Profile is null)
        {
            <div class="wap-line">请先创建角色</div>
            <button class="wap-button" @onclick="GoCreateCharacter">创建角色</button>
        }
        else
        {
            <header class="monster-topbar">
                <div class="monster-top-level">等级:@_account.Level</div>
                <div class="monster-top-resource power"><span>妖</span><b>@_account.Monsters.Count</b></div>
                <div class="monster-top-resource coin"><span>金</span><b>@_account.Copper</b></div>
                <div class="monster-top-resource gem"><span>战</span><b>@TotalPower</b></div>
                <button class="monster-settings" aria-label="设置">⚙</button>
            </header>

            <div class="monster-stage">
                <div class="monster-heading">
                    <h1>我的妖怪</h1>
                </div>

                <section class="monster-roster-panel">
                    <div class="monster-position-tabs">
                        @foreach (string position in PositionTabs)
                        {
                            <button class="@(_selectedPosition == position ? "active" : "")" @onclick="() => SelectPosition(position)">@position</button>
                        }
                    </div>

                    <div class="monster-list">
                        @foreach (OwnedMonster monster in FilteredMonsters)
                        {
                            <button class="monster-card @ResolveStageFrameClass(monster.Stage)" @onclick="() => GoMonsterDetail(monster.Id)">
                                <span class="monster-portrait">
                                    <img src="@monster.PortraitUrl" alt="@monster.Name" />
                                    <span class="monster-level">Lv.@monster.Level</span>
                                    <span class="monster-stars">@BuildStars(monster.Star)</span>
                                </span>
                            </button>
                        }
                    </div>
                </section>
            </div>

            <footer class="monster-bottom-bar">
                <button class="monster-back" @onclick="GoHome">‹</button>
                <button class="active">妖怪</button>
                <button disabled>阵容</button>
                <button disabled>图鉴</button>
            </footer>
        }
    </section>
</main>

@code {
    private static readonly string[] PositionTabs = ["前排", "中排", "后排"];
    private PlayerAccount? _account;
    private string _selectedPosition = "前排";

    private int TotalPower
        => _account?.Monsters.Sum(monster => monster.Power) ?? 0;

    private IEnumerable<OwnedMonster> FilteredMonsters
        => _account?.Monsters
            .Where(monster => string.Equals(monster.Position, _selectedPosition, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(monster => monster.Power)
            ?? Enumerable.Empty<OwnedMonster>();

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        if (_account?.Profile is not null)
        {
            Quests.ReportEvent(Session.UserName, QuestEventType.ViewMonsters);
        }
    }

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoMonsterDetail(int monsterId)
        => Navigation.NavigateTo($"/monsters/{monsterId}");

    private void GoHome()
        => Navigation.NavigateTo("/");

    private void SelectPosition(string position)
        => _selectedPosition = position;

    private static string BuildStars(int star)
        => new('★', Math.Clamp(star, 1, 5));

    private static string ResolveStageFrameClass(int stage)
        => $"stage-{Math.Clamp(stage, 1, GameAccountStore.MaxMonsterStage)}";
}
