@page "/campaign"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject CampaignStore Campaigns

<PageTitle>副本</PageTitle>

<main class="campaign-page">
    <section class="campaign-panel">
        @if (_account is null)
        {
            <div class="campaign-stage state-only">
                <div class="campaign-heading">
                    <h1>副本</h1>
                </div>
                <div class="campaign-empty-state">请先登录</div>
                <button class="campaign-primary-action" @onclick="GoLogin">返回登录</button>
            </div>
        }
        else if (_account.Profile is null)
        {
            <div class="campaign-stage state-only">
                <div class="campaign-heading">
                    <h1>副本</h1>
                </div>
                <div class="campaign-empty-state">请先创建角色</div>
                <button class="campaign-primary-action" @onclick="GoCreateCharacter">创建角色</button>
            </div>
        }
        else
        {
            <header class="campaign-topbar">
                <div class="campaign-top-level">等级:@_account.Level</div>
                <div class="campaign-top-resource power"><span>章</span><b>@UnlockedChapterCount</b></div>
                <div class="campaign-top-resource coin"><span>钱</span><b>@_account.Copper</b></div>
                <div class="campaign-top-resource gem"><span>战</span><b>@TotalPower</b></div>
                <button class="campaign-settings" aria-label="设置" disabled>!</button>
            </header>

            <div class="campaign-stage">
                <div class="campaign-heading">
                    <h1>副本</h1>
                </div>

                <div class="campaign-list">
                    @foreach (CampaignChapterDefinition chapter in _chapters)
                    {
                        <button class="campaign-chapter @(chapter.Unlocked ? "" : "locked")" disabled="@(!chapter.Unlocked)" @onclick="() => GoChapter(chapter.Id)">
                            <b>@chapter.Name</b>
                            <span>@chapter.Description</span>
                            <small>@(chapter.Unlocked ? "进入章节" : "未开放")</small>
                        </button>
                    }

                    @if (_chapters.Count == 0)
                    {
                        <div class="campaign-empty">暂无副本</div>
                    }
                </div>
            </div>

            <footer class="campaign-bottom-bar">
                <button class="campaign-back" @onclick="GoHome">返回</button>
                <button class="active">副本</button>
                <button disabled>章节</button>
                <button disabled>扫荡</button>
            </footer>
        }
    </section>
</main>

@code {
    private PlayerAccount? _account;
    private IReadOnlyList<CampaignChapterDefinition> _chapters = Array.Empty<CampaignChapterDefinition>();

    private int TotalPower
        => _account?.Monsters.Sum(monster => monster.Power) ?? 0;

    private int UnlockedChapterCount
        => _chapters.Count(chapter => chapter.Unlocked);

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        _chapters = Campaigns.GetChapters();
    }

    private void GoChapter(string chapterId)
        => Navigation.NavigateTo($"/campaign/{chapterId}");

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoHome()
        => Navigation.NavigateTo("/");
}
