@page "/backpack"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts

<PageTitle>背包</PageTitle>

<main class="backpack-page">
    <section class="backpack-panel">
        @if (_account is null)
        {
            <div class="backpack-stage state-only">
                <div class="backpack-heading">
                    <h1>背包</h1>
                </div>
                <div class="backpack-empty-state">请先登录</div>
                <button class="backpack-primary-action" @onclick="GoLogin">返回登录</button>
            </div>
        }
        else if (_account.Profile is null)
        {
            <div class="backpack-stage state-only">
                <div class="backpack-heading">
                    <h1>背包</h1>
                </div>
                <div class="backpack-empty-state">请先创建角色</div>
                <button class="backpack-primary-action" @onclick="GoCreateCharacter">创建角色</button>
            </div>
        }
        else
        {
            <header class="backpack-topbar">
                <div class="backpack-top-level">等级:@_account.Level</div>
                <div class="backpack-top-resource power"><span>物</span><b>@TotalItemKinds</b></div>
                <div class="backpack-top-resource coin"><span>钱</span><b>@_account.Copper</b></div>
                <div class="backpack-top-resource gem"><span>战</span><b>@TotalPower</b></div>
                <button class="backpack-settings" aria-label="设置" disabled>!</button>
            </header>

            <div class="backpack-stage">
                <div class="backpack-heading">
                    <h1>背包</h1>
                </div>

                <div class="backpack-tabs">
                    <button class="@(_tab == BackpackTab.Consumables ? "active" : "")" @onclick="() => SelectTab(BackpackTab.Consumables)">道具</button>
                    <button class="@(_tab == BackpackTab.Equipment ? "active" : "")" @onclick="() => SelectTab(BackpackTab.Equipment)">装备</button>
                    <button class="@(_tab == BackpackTab.Fragments ? "active" : "")" @onclick="() => SelectTab(BackpackTab.Fragments)">碎片</button>
                </div>

                <div class="backpack-grid">
                    @if (_tab == BackpackTab.Consumables)
                    {
                        @foreach (BackpackConsumableItem item in SortedConsumables)
                        {
                            <button class="backpack-item @(item.TemplateId == _selectedConsumableId ? "selected" : "")" @onclick="() => OpenConsumable(item.TemplateId)">
                                <span class="backpack-icon">@item.IconText</span>
                                <small>x@(item.Quantity)</small>
                            </button>
                        }
                        @if (!SortedConsumables.Any())
                        {
                            <div class="backpack-grid-empty">道具为空</div>
                        }
                    }
                    else if (_tab == BackpackTab.Equipment)
                    {
                        @foreach (BackpackEquipmentItem item in SortedEquipment)
                        {
                            <button class="backpack-item @ResolveEquipmentQualityClass(item.Quality) @(item.EquippedMonsterId is null ? "" : "equipped") @(item.InstanceId == _selectedEquipmentId ? "selected" : "")" @onclick="() => OpenEquipment(item.InstanceId)">
                                <span class="backpack-icon">@item.IconText</span>
                                <small class="equipment-level-badge">+@item.UpgradeLevel</small>
                                @if (item.EquippedMonsterId is not null)
                                {
                                    <small class="equipment-equipped-badge">穿</small>
                                }
                            </button>
                        }
                        @if (!SortedEquipment.Any())
                        {
                            <div class="backpack-grid-empty">装备为空</div>
                        }
                    }
                    else
                    {
                        @foreach (BackpackFragmentItem item in SortedFragments)
                        {
                            <button class="backpack-item @(item.TemplateId == _selectedFragmentId ? "selected" : "")" @onclick="() => OpenFragment(item.TemplateId)">
                                <span class="backpack-icon">@item.IconText</span>
                                <small>x@(item.Quantity)</small>
                            </button>
                        }
                        @if (!SortedFragments.Any())
                        {
                            <div class="backpack-grid-empty">碎片为空</div>
                        }
                    }
                </div>
            </div>

            <footer class="backpack-bottom-bar">
                <button class="backpack-back" @onclick="GoHome">返回</button>
                <button class="active">背包</button>
                <button @onclick="GoMonsters">妖怪</button>
                <button disabled>熔炼</button>
            </footer>

            @if (_showDetailPopup)
            {
                <div class="backpack-popup-backdrop" @onclick="CloseDetailPopup">
                    <section class="backpack-popup" @onclick:stopPropagation="true">
                        <button class="backpack-popup-close" aria-label="关闭" @onclick="CloseDetailPopup">x</button>
                        @if (_tab == BackpackTab.Consumables && SelectedConsumable is not null)
                        {
                            <div class="backpack-detail-icon">@SelectedConsumable.IconText</div>
                            <div class="backpack-detail-main">
                                <div class="backpack-detail-name">@SelectedConsumable.Name</div>
                                <div class="backpack-detail-line">数量：@SelectedConsumable.Quantity</div>
                                <div class="backpack-detail-line">@SelectedConsumable.Description</div>
                            </div>
                        }
                        else if (_tab == BackpackTab.Equipment && SelectedEquipment is not null)
                        {
                            <div class="backpack-detail-icon @ResolveEquipmentQualityClass(SelectedEquipment.Quality)">@SelectedEquipment.IconText</div>
                            <div class="backpack-detail-main">
                                <div class="backpack-detail-name">@SelectedEquipment.Name</div>
                                <div class="backpack-detail-line">@ResolveSlotName(SelectedEquipment.SlotKey) / @SelectedEquipment.Quality / 强化 +@SelectedEquipment.UpgradeLevel / 战力 +@SelectedEquipment.Power</div>
                                <div class="backpack-detail-line">@SelectedEquipment.AttributeText</div>
                                @if (SelectedEquipment.EquippedMonsterId is int monsterId)
                                {
                                    <div class="backpack-detail-line">已穿戴：@ResolveMonsterName(monsterId)</div>
                                }
                                else
                                {
                                    <div class="backpack-detail-line">未穿戴</div>
                                }
                            </div>
                        }
                        else if (_tab == BackpackTab.Fragments && SelectedFragment is not null)
                        {
                            <div class="backpack-detail-icon">@SelectedFragment.IconText</div>
                            <div class="backpack-detail-main">
                                <div class="backpack-detail-name">@SelectedFragment.Name</div>
                                <div class="backpack-detail-line">@SelectedFragment.Quality / 数量：@SelectedFragment.Quantity</div>
                                <div class="backpack-detail-line">@SelectedFragment.Description</div>
                            </div>
                        }
                    </section>
                </div>
            }
        }
    </section>
</main>

@code {
    private PlayerAccount? _account;
    private BackpackTab _tab = BackpackTab.Consumables;
    private string? _selectedConsumableId;
    private int? _selectedEquipmentId;
    private string? _selectedFragmentId;
    private bool _showDetailPopup;

    private int TotalItemKinds
        => (_account?.Consumables.Count(item => item.Quantity > 0) ?? 0)
            + (_account?.Backpack.Count ?? 0)
            + (_account?.Fragments.Count(item => item.Quantity > 0) ?? 0);

    private int TotalPower
        => _account?.Monsters.Sum(monster => monster.Power) ?? 0;

    private IEnumerable<BackpackConsumableItem> SortedConsumables
        => _account?.Consumables
            .Where(item => item.Quantity > 0)
            .OrderBy(item => item.TemplateId)
            ?? Enumerable.Empty<BackpackConsumableItem>();

    private IEnumerable<BackpackEquipmentItem> SortedEquipment
        => _account?.Backpack
            .OrderBy(item => item.EquippedMonsterId is null)
            .ThenBy(item => item.SlotKey)
            .ThenByDescending(item => item.Power)
            ?? Enumerable.Empty<BackpackEquipmentItem>();

    private IEnumerable<BackpackFragmentItem> SortedFragments
        => _account?.Fragments
            .Where(item => item.Quantity > 0)
            .OrderBy(item => item.TemplateId)
            ?? Enumerable.Empty<BackpackFragmentItem>();

    private BackpackConsumableItem? SelectedConsumable
        => SortedConsumables.FirstOrDefault(item => item.TemplateId == _selectedConsumableId)
            ?? SortedConsumables.FirstOrDefault();

    private BackpackEquipmentItem? SelectedEquipment
        => SortedEquipment.FirstOrDefault(item => item.InstanceId == _selectedEquipmentId)
            ?? SortedEquipment.FirstOrDefault();

    private BackpackFragmentItem? SelectedFragment
        => SortedFragments.FirstOrDefault(item => item.TemplateId == _selectedFragmentId)
            ?? SortedFragments.FirstOrDefault();

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        SyncDefaultSelection();
    }

    private void SelectTab(BackpackTab tab)
    {
        _tab = tab;
        _showDetailPopup = false;
        SyncDefaultSelection();
    }

    private void SyncDefaultSelection()
    {
        if (_selectedConsumableId is null || !SortedConsumables.Any(item => item.TemplateId == _selectedConsumableId))
        {
            _selectedConsumableId = SortedConsumables.FirstOrDefault()?.TemplateId;
        }

        if (_selectedEquipmentId is null || !SortedEquipment.Any(item => item.InstanceId == _selectedEquipmentId))
        {
            _selectedEquipmentId = SortedEquipment.FirstOrDefault()?.InstanceId;
        }

        if (_selectedFragmentId is null || !SortedFragments.Any(item => item.TemplateId == _selectedFragmentId))
        {
            _selectedFragmentId = SortedFragments.FirstOrDefault()?.TemplateId;
        }
    }

    private void OpenConsumable(string templateId)
    {
        SelectConsumable(templateId);
        _showDetailPopup = true;
    }

    private void OpenEquipment(int itemInstanceId)
    {
        SelectEquipment(itemInstanceId);
        _showDetailPopup = true;
    }

    private void OpenFragment(string templateId)
    {
        SelectFragment(templateId);
        _showDetailPopup = true;
    }

    private void SelectConsumable(string templateId)
        => _selectedConsumableId = templateId;

    private void SelectEquipment(int itemInstanceId)
        => _selectedEquipmentId = itemInstanceId;

    private void SelectFragment(string templateId)
        => _selectedFragmentId = templateId;

    private void CloseDetailPopup()
        => _showDetailPopup = false;

    private string ResolveMonsterName(int monsterId)
        => _account?.Monsters.FirstOrDefault(monster => monster.Id == monsterId)?.Name ?? "未知";

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoHome()
        => Navigation.NavigateTo("/");

    private void GoMonsters()
        => Navigation.NavigateTo("/monsters");

    private static string ResolveSlotName(string slotKey)
        => slotKey switch
        {
            "weapon" => "武器",
            "armor" => "护甲",
            "necklace" => "饰品",
            "boots" => "鞋子",
            "relic" => "法器",
            "soul" => "命星",
            _ => "装备",
        };

    private static string ResolveEquipmentQualityClass(string quality)
        => quality switch
        {
            "白" => "quality-1",
            "绿" => "quality-2",
            "蓝" => "quality-3",
            "紫" => "quality-4",
            "红" => "quality-5",
            _ => "quality-1",
        };

    private enum BackpackTab
    {
        Consumables,
        Equipment,
        Fragments,
    }
}
