@page "/monsters/{MonsterId:int}"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject QuestStore Quests
@using XunyaoAdventure.Battle

<PageTitle>妖怪详情</PageTitle>

<main class="monster-page">
    <section class="monster-panel">

        @if (_account is null)
        {
            <div class="wap-line">请先登录</div>
            <button class="wap-button" @onclick="GoLogin">返回登录</button>
        }
        else if (_monster is null)
        {
            <div class="wap-line">没有找到这个妖怪</div>
            <button class="wap-button muted" @onclick="GoMonsters">返回妖怪</button>
        }
        else
        {
            <header class="monster-topbar">
                <div class="monster-top-level">等级:@_account.Level</div>
                <div class="monster-top-resource power"><span>战</span><b>@_monster.Power</b></div>
                <div class="monster-top-resource coin"><span>金</span><b>@_account.Copper</b></div>
                <div class="monster-top-resource gem"><span>晶</span><b>@DemonEssenceCount</b></div>
                <button class="monster-settings" aria-label="设置">⚙</button>
            </header>

            <div class="monster-detail-stage">
                <div class="monster-detail-main">
                    <div class="monster-detail-header">
                        <span class="monster-detail-name">@_monster.Name</span>
                        <span class="monster-detail-power">战力 @_monster.Power</span>
                        <button class="monster-detail-link" @onclick="OpenAttributePopup">查看属性</button>
                    </div>

                    <div class="monster-detail-orbit">
                        <div class="monster-detail-avatar-wrap">
                            <span class="monster-portrait monster-detail-avatar @ResolveStageFrameClass(_monster.Stage)">
                                <img src="@_monster.PortraitUrl" alt="@_monster.Name" />
                                <span class="monster-stars">@BuildStars(_monster.Star)</span>
                            </span>
                        </div>

                        @foreach (MonsterEquipmentSlot slot in _monster.Equipment)
                        {
                            BackpackEquipmentItem? slotItem = ResolveSlotItem(slot);
                            ResolvedEquipmentItem? slotEquipment = slotItem is null ? null : ResolveEquipment(slotItem);
                            <button class="monster-detail-equip @ResolveSlotOrbitClass(slot.SlotKey) @ResolveEquipmentQualityClass(slotEquipment?.Quality) @(slot.Equipped ? "equipped" : "")" @onclick="() => OpenEquipmentPopup(slot.SlotKey)">
                                @if (slotEquipment is not null)
                                {
                                    <ItemImage CssClass="monster-slot-image" ImagePath="@slotEquipment.ImagePath" Alt="@slotEquipment.Name" />
                                }
                                @if (slotEquipment is not null)
                                {
                                    <em class="equipment-level-badge">+@slotEquipment.UpgradeLevel</em>
                                }
                                @if (slotEquipment is not null)
                                {
                                    <small>Lv.@Math.Max(1, slotEquipment.UpgradeLevel)</small>
                                }
                                else
                                {
                                    <small class="monster-empty-slot-label">@ResolveSlotName(slot.SlotKey)</small>
                                }
                            </button>
                        }
                    </div>

                    <div class="monster-exp">
                        <span style="width:@ExperiencePercent%"></span>
                        <b>经验:@_monster.Experience/@NextLevelExperience (@ExperiencePercentText)</b>
                    </div>
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="wap-message">@_message</div>
            }

            <footer class="monster-bottom-tabs">
                <button class="monster-back" @onclick="GoMonsters">返回</button>
                <button class="@(_detailTab == MonsterDetailTab.Basic ? "active" : "")" @onclick="() => _detailTab = MonsterDetailTab.Basic">装备</button>
                <button @onclick="OpenAttributePopup">属性</button>
                <button>饰品</button>
            </footer>
        }
    </section>

    @if (_showAttributePopup && _monster is not null && CurrentStats is HeroFinalStats attributeStats)
    {
        <div class="attribute-popup-backdrop" @onclick="CloseAttributePopup">
            <section class="attribute-popup" @onclick:stopPropagation="true">
                <button class="attribute-popup-close" aria-label="关闭属性" @onclick="CloseAttributePopup">!</button>

                <div class="attribute-section">
                    <h2>基础信息</h2>
                    <div class="profile-grid">
                        <div><span>定位:</span><b>@_monster.Attribute 系 / @_monster.Element / @_monster.Position</b></div>
                        <div>
                            <span>等级:</span>
                            <b>@_monster.Level</b>
                            <button @onclick="OpenLevelUpFromAttributePopup">升级</button>
                        </div>
                        <div>
                            <span>星级:</span>
                            <b>@_monster.Star / @GameAccountStore.MaxMonsterStar 星</b>
                            @if (_monster.Star < GameAccountStore.MaxMonsterStar)
                            {
                                <button @onclick="OpenStarUpFromAttributePopup">升星</button>
                            }
                        </div>
                        <div><span>战力:</span><b>@_monster.Power</b></div>
                        <div><span>阶级:</span><b>@_monster.Stage / @GameAccountStore.MaxMonsterStage 阶</b></div>
                        <div>
                            <span>妖元:</span>
                            <b>@_monster.DemonEssence / @RequiredDemonEssenceText</b>
                            @if (_monster.Stage < GameAccountStore.MaxMonsterStage && _monster.DemonEssence < GameAccountStore.MaxDemonEssence)
                            {
                                <button disabled="@(DemonEssenceCount <= 0)" @onclick="OpenDemonEssenceFromAttributePopup">吸收</button>
                            }
                            @if (CanBreakthrough)
                            {
                                <button @onclick="ConfirmBreakthrough">突破</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="attribute-section">
                    <h2>战斗属性</h2>
                    <div class="attribute-grid">
                        <div><span>力量:</span><b>@FormatStat(attributeStats.Strength)</b></div>
                        <div><span>智力:</span><b>@FormatStat(attributeStats.Intelligence)</b></div>
                        <div><span>敏捷:</span><b>@FormatStat(attributeStats.Agility)</b></div>
                        <div><span>最大生命值:</span><b>@FormatStat(attributeStats.MaxHp)</b></div>
                        <div><span>物理攻击力:</span><b>@FormatStat(attributeStats.PhysicalAttack)</b></div>
                        <div><span>魔法强度:</span><b>@FormatStat(attributeStats.MagicPower)</b></div>
                        <div><span>物理护甲:</span><b>@FormatStat(attributeStats.PhysicalArmor)</b></div>
                        <div><span>魔法抗性:</span><b>@FormatStat(attributeStats.MagicResist)</b></div>
                        <div><span>物理暴击:</span><b>@FormatStat(attributeStats.PhysicalCrit)</b></div>
                        <div><span>生命回复:</span><b>@FormatStat(attributeStats.HpRegen)</b></div>
                        <div><span>能量回复:</span><b>@FormatDecimal(attributeStats.EnergyRegen)</b></div>
                        <div><span>打断阈值:</span><b>@FormatStat(attributeStats.InterruptThreshold)</b></div>
                    </div>
                </div>
            </section>
        </div>
    }

    @if (_showEquipmentPopup)
    {
        <div class="equipment-popup-backdrop equipment-inspect-backdrop" @onclick="CloseEquipmentPopup">
            <section class="equipment-popup equipment-inspect-popup" @onclick:stopPropagation="true">
                <div class="equipment-inspect-scroll">
                    @if (_selectedSlot?.Equipped == true)
                    {
                        <section class="equipment-inspect-card current">
                            @if (EquippedSlotItem is null)
                            {
                                <div class="equipment-empty-detail">
                                    <b>@ResolveSlotName(_selectedSlotKey)</b>
                                    <small>当前槽位没有装备</small>
                                </div>
                            }
                            else
                            {
                                ResolvedEquipmentItem equipment = ResolveEquipment(EquippedSlotItem);
                                <h3 class="@ResolveEquipmentTextQualityClass(equipment.Quality)">@equipment.Name</h3>
                                <div class="equipment-equipped-stamp">已装备</div>
                                <div class="equipment-card-main">
                                    <ItemImage CssClass="@($"backpack-detail-icon {ResolveEquipmentQualityClass(equipment.Quality)}")" ImagePath="@equipment.ImagePath" Alt="@equipment.Name" />
                                    <div class="equipment-card-summary @ResolveEquipmentTextQualityClass(equipment.Quality)">
                                        <div>等级： @Math.Max(1, equipment.UpgradeLevel)</div>
                                        <div>品质： @equipment.Quality</div>
                                        <div>战力： @equipment.Power</div>
                                    </div>
                                </div>
                                <div class="equipment-card-line">[基础属性]</div>
                                <div class="equipment-card-stat">@FormatEquipmentAttributeText(equipment)</div>
                                <div class="equipment-card-line">[词缀效果]</div>
                                <div class="equipment-card-stat">@ResolveEquipmentAffixText(equipment)</div>
                                <div class="equipment-card-muted">强化费用：@ResolveUpgradeCost(equipment) 铜钱</div>
                            }
                        </section>
                    }

                    <section class="equipment-inspect-card candidate">
                        @if (SelectedCandidateItem is null)
                        {
                            <div class="equipment-empty-detail">
                                <b>@ResolveSlotName(_selectedSlotKey)</b>
                                <small>点击下方未穿戴装备查看详情</small>
                            </div>
                        }
                        else
                        {
                            ResolvedEquipmentItem equipment = ResolveEquipment(SelectedCandidateItem);
                            <h3 class="@ResolveEquipmentTextQualityClass(equipment.Quality)">@equipment.Name</h3>
                            <div class="equipment-card-main">
                                <ItemImage CssClass="@($"backpack-detail-icon {ResolveEquipmentQualityClass(equipment.Quality)}")" ImagePath="@equipment.ImagePath" Alt="@equipment.Name" />
                                <div class="equipment-card-summary @ResolveEquipmentTextQualityClass(equipment.Quality)">
                                    <div>等级： @Math.Max(1, equipment.UpgradeLevel)</div>
                                    <div>品质： @equipment.Quality</div>
                                    <div>战力： @equipment.Power</div>
                                    </div>
                                </div>
                                <div class="equipment-card-line">[基础属性]</div>
                                <div class="equipment-card-stat">@FormatEquipmentAttributeText(equipment)</div>
                                <div class="equipment-card-line">[词缀效果]</div>
                                <div class="equipment-card-stat">@ResolveEquipmentAffixText(equipment)</div>
                                <div class="equipment-card-muted">强化费用：@ResolveUpgradeCost(equipment) 铜钱</div>
                        }
                    </section>

                </div>

                <div class="equipment-popup-actions">
                    @if (_selectedSlot?.Equipped == true)
                    {
                        @if (SelectedCandidateItem is not null)
                        {
                            <button class="wap-button" @onclick="EquipSelectedCandidate">替换</button>
                        }
                        else
                        {
                            <button class="wap-button" @onclick="OpenReplacementPicker">替换</button>
                        }
                        <button class="wap-button muted" disabled="@(!CanUpgradeEquipment(EquippedSlotItem))" @onclick="UpgradeEquippedSlotItem">强化</button>
                        <button class="wap-button muted" @onclick="UnequipSelected">卸下</button>
                    }
                    else
                    {
                        @if (SelectedCandidateItem is not null)
                        {
                            <button class="wap-button" @onclick="EquipSelectedCandidate">穿戴</button>
                            <button class="wap-button muted" disabled="@(!CanUpgradeEquipment(SelectedCandidateItem))" @onclick="UpgradeSelectedCandidate">强化</button>
                        }
                    }
                </div>
                <div class="equipment-popup-hint">点击空白区域关闭窗口</div>
            </section>
        </div>
    }

    @if (_showEquipmentPicker)
    {
        <div class="equipment-popup-backdrop equipment-picker-backdrop" @onclick="CloseEquipmentPicker">
            <section class="equipment-popup equipment-picker-popup" @onclick:stopPropagation="true">
                <div class="equipment-picker-grid">
                    @foreach (BackpackEquipmentItem item in CandidateItems)
                    {
                        ResolvedEquipmentItem equipment = ResolveEquipment(item);
                        <button class="monster-bag-item @ResolveEquipmentQualityClass(equipment.Quality)" @onclick="() => InspectCandidateItem(item.InstanceId)">
                            <em></em>
                            <ItemImage CssClass="monster-bag-image" ImagePath="@equipment.ImagePath" Alt="@equipment.Name" />
                            @if (equipment.UpgradeLevel > 0)
                            {
                                <strong>+@equipment.UpgradeLevel</strong>
                            }
                            <small>Lv.@Math.Max(1, equipment.UpgradeLevel)</small>
                        </button>
                    }
                    @if (CandidateItems.Count == 0)
                    {
                        <div class="equipment-picker-empty">暂无可穿戴装备</div>
                    }
                    @if (CandidateItems.Count > 0)
                    {
                        @for (int i = CandidateItems.Count; i < 18; i++)
                        {
                            <span class="monster-bag-item empty"></span>
                        }
                    }
                </div>
            </section>
        </div>
    }

    @if (_showLevelUpPopup && _monster is not null)
    {
        <div class="equipment-popup-backdrop" @onclick="CloseLevelUpPopup">
            <section class="levelup-popup" @onclick:stopPropagation="true">
                <header class="equipment-popup-title">
                    <span>妖怪升级</span>
                    <button @onclick="CloseLevelUpPopup">x</button>
                </header>

                <div class="levelup-body">
                    <div class="levelup-current">
                        <div>当前等级 <b>@_monster.Level</b></div>
                        <div>当前经验 <b>@_monster.Experience / @NextLevelExperience</b></div>
                        <div>经验药水 <b>@ExpPotionCount</b></div>
                        <div>单瓶经验 <b>@GameAccountStore.ExpPotionValue</b></div>
                    </div>

                    <label class="wap-field">
                        <span>药水数量</span>
                        <input type="number" min="1" max="@ExpPotionCount" @bind="_potionCount" />
                    </label>

                    <div class="levelup-preview">
                        预计升到：@PreviewLevel 级，剩余经验：@PreviewExperience / @PreviewNextLevelExperience
                    </div>
                </div>

                <div class="equipment-popup-actions">
                    <button class="wap-button" disabled="@(ExpPotionCount <= 0)" @onclick="ConfirmLevelUp">确认升级</button>
                </div>
            </section>
        </div>
    }

    @if (_showStarUpPopup && _monster is not null)
    {
        <div class="equipment-popup-backdrop" @onclick="CloseStarUpPopup">
            <section class="levelup-popup" @onclick:stopPropagation="true">
                <header class="equipment-popup-title">
                    <span>妖怪升星</span>
                    <button @onclick="CloseStarUpPopup">x</button>
                </header>

                <div class="levelup-body">
                    <div class="levelup-current">
                        <div>当前星级 <b>@_monster.Star / @GameAccountStore.MaxMonsterStar</b></div>
                        <div>背包灵魂石 <b>@SoulStoneCount</b></div>
                        <div>本次需要 <b>@RequiredSoulStones</b></div>
                        <div>升星后 <b>@Math.Min(GameAccountStore.MaxMonsterStar, _monster.Star + 1) 星</b></div>
                    </div>

                    <div class="levelup-preview">
                        灵魂石是通用升星材料，升星后会提升战斗属性和战力。
                    </div>
                </div>

                <div class="equipment-popup-actions">
                    <button class="wap-button" disabled="@(!CanStarUp)" @onclick="ConfirmStarUp">确认升星</button>
                </div>
            </section>
        </div>
    }

    @if (_showDemonEssencePopup && _monster is not null)
    {
        <div class="equipment-popup-backdrop" @onclick="CloseDemonEssencePopup">
            <section class="levelup-popup" @onclick:stopPropagation="true">
                <header class="equipment-popup-title">
                    <span>吸收妖元</span>
                    <button @onclick="CloseDemonEssencePopup">x</button>
                </header>

                <div class="levelup-body">
                    <div class="levelup-current">
                        <div>当前妖元 <b>@_monster.DemonEssence / @GameAccountStore.MaxDemonEssence</b></div>
                        <div>背包妖元 <b>@DemonEssenceCount</b></div>
                        <div>突破妖元 <b>@RequiredDemonEssenceText</b></div>
                        <div>破境丹 <b>@BreakthroughPillCount / @RequiredPills</b></div>
                    </div>

                    <label class="wap-field">
                        <span>妖元数量</span>
                        <input type="number" min="1" max="@MaxUsableDemonEssence" @bind="_demonEssenceCount" />
                    </label>

                    <div class="levelup-preview">
                        预计妖元：@PreviewDemonEssence / @GameAccountStore.MaxDemonEssence
                    </div>
                </div>

                <div class="equipment-popup-actions">
                    <button class="wap-button" disabled="@(MaxUsableDemonEssence <= 0)" @onclick="ConfirmDemonEssence">确认吸收</button>
                </div>
            </section>
        </div>
    }
</main>

@code {
    [Parameter]
    public int MonsterId { get; set; }

    private PlayerAccount? _account;
    private OwnedMonster? _monster;
    private string _selectedSlotKey = string.Empty;
    private int? _selectedItemId;
    private string _message = string.Empty;
    private bool _showEquipmentPopup;
    private bool _showEquipmentPicker;
    private bool _showAttributePopup;
    private bool _showLevelUpPopup;
    private bool _showStarUpPopup;
    private bool _showDemonEssencePopup;
    private int _potionCount = 1;
    private int _demonEssenceCount = 1;
    private MonsterDetailTab _detailTab = MonsterDetailTab.Basic;

    private MonsterEquipmentSlot? _selectedSlot
        => _monster?.Equipment.FirstOrDefault(slot => slot.SlotKey == _selectedSlotKey);

    private BackpackEquipmentItem? EquippedSlotItem
        => _selectedSlot?.ItemInstanceId is int itemInstanceId
            ? _account?.Backpack.FirstOrDefault(item => item.InstanceId == itemInstanceId)
            : null;

    private List<BackpackEquipmentItem> CandidateItems
        => _account?.Backpack
            .Where(item => ResolveEquipment(item).SlotKey == _selectedSlotKey)
            .Where(item => item.EquippedMonsterId is null)
            .OrderByDescending(item => ResolveEquipment(item).Power)
            .ThenBy(item => ResolveEquipment(item).Name)
            .ToList()
            ?? new List<BackpackEquipmentItem>();

    private BackpackEquipmentItem? SelectedCandidateItem
        => _selectedItemId is int selectedItemId
            ? CandidateItems.FirstOrDefault(item => item.InstanceId == selectedItemId)
            : null;

    private HeroFinalStats? CurrentStats
        => _monster is null ? null : BattleDemoSetupFactory.CalculateMonsterStats(_monster);

    private int ExpPotionCount
        => _account?.Consumables.FirstOrDefault(item => item.EffectType == "MonsterExp")?.Quantity ?? 0;

    private int DemonEssenceCount
        => _account?.Consumables.FirstOrDefault(item => item.EffectType == "DemonEssence")?.Quantity ?? 0;

    private int BreakthroughPillCount
        => _account?.Consumables.FirstOrDefault(item => item.EffectType == "BreakthroughPill")?.Quantity ?? 0;

    private int SoulStoneCount
        => _account?.Consumables.FirstOrDefault(item => item.EffectType == "SoulStone")?.Quantity ?? 0;

    private int RequiredSoulStones
        => _monster is null || _monster.Star >= GameAccountStore.MaxMonsterStar
            ? 0
            : GameAccountStore.GetRequiredSoulStonesForStar(_monster.Star);

    private bool CanStarUp
        => _monster is not null
            && _monster.Star < GameAccountStore.MaxMonsterStar
            && SoulStoneCount >= RequiredSoulStones;

    private int RequiredDemonEssence
        => _monster is null || _monster.Stage >= GameAccountStore.MaxMonsterStage
            ? GameAccountStore.MaxDemonEssence
            : GameAccountStore.GetRequiredDemonEssenceForStage(_monster.Stage);

    private string RequiredDemonEssenceText
        => _monster is null || _monster.Stage >= GameAccountStore.MaxMonsterStage
            ? $"{GameAccountStore.MaxDemonEssence}（满阶）"
            : RequiredDemonEssence.ToString();

    private int RequiredPills
        => _monster is null || _monster.Stage >= GameAccountStore.MaxMonsterStage
            ? 0
            : GameAccountStore.GetRequiredBreakthroughPills(_monster.Stage);

    private bool CanBreakthrough
        => _monster is not null
            && _monster.Stage < GameAccountStore.MaxMonsterStage
            && _monster.DemonEssence >= RequiredDemonEssence
            && BreakthroughPillCount >= RequiredPills;

    private int MaxUsableDemonEssence
        => _monster is null ? 0 : Math.Min(DemonEssenceCount, GameAccountStore.MaxDemonEssence - _monster.DemonEssence);

    private int PreviewDemonEssence
        => _monster is null ? 0 : Math.Min(GameAccountStore.MaxDemonEssence, _monster.DemonEssence + Math.Max(0, Math.Min(_demonEssenceCount, MaxUsableDemonEssence)));

    private int NextLevelExperience
        => _monster is null ? 0 : GameAccountStore.GetRequiredExperienceForNextLevel(_monster.Level);

    private int ExperiencePercent
        => _monster is null || NextLevelExperience <= 0
            ? 0
            : Math.Clamp((int)Math.Round(_monster.Experience * 100.0 / NextLevelExperience), 0, 100);

    private string ExperiencePercentText
        => $"{ExperiencePercent}%";

    private int PreviewLevel
        => PreviewLevelUp().Level;

    private int PreviewExperience
        => PreviewLevelUp().Experience;

    private int PreviewNextLevelExperience
        => GameAccountStore.GetRequiredExperienceForNextLevel(PreviewLevel);

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        if (_account is null)
        {
            return;
        }

        _monster = Accounts.GetMonster(Session.UserName, MonsterId);
    }

    private void OpenEquipmentPopup(string slotKey, int? selectedItemId = null)
    {
        _message = string.Empty;
        _selectedSlotKey = slotKey;
        _selectedItemId = selectedItemId;
        if (_selectedSlot?.Equipped == true)
        {
            _showEquipmentPicker = false;
            _showEquipmentPopup = true;
            return;
        }

        _showEquipmentPopup = false;
        _showEquipmentPicker = true;
    }

    private void CloseEquipmentPopup()
    {
        _showEquipmentPopup = false;
    }

    private void CloseEquipmentPicker()
    {
        _showEquipmentPicker = false;
    }

    private void OpenReplacementPicker()
    {
        _selectedItemId = null;
        _showEquipmentPopup = false;
        _showEquipmentPicker = true;
    }

    private void OpenAttributePopup()
    {
        if (_monster is null)
        {
            return;
        }

        _message = string.Empty;
        _showAttributePopup = true;
    }

    private void CloseAttributePopup()
    {
        _showAttributePopup = false;
    }

    private void OpenLevelUpFromAttributePopup()
    {
        CloseAttributePopup();
        OpenLevelUpPopup();
    }

    private void OpenStarUpFromAttributePopup()
    {
        CloseAttributePopup();
        OpenStarUpPopup();
    }

    private void OpenDemonEssenceFromAttributePopup()
    {
        CloseAttributePopup();
        OpenDemonEssencePopup();
    }

    private void SelectCandidateItem(int itemInstanceId)
    {
        _selectedItemId = itemInstanceId;
    }

    private void EquipSelectedCandidate()
    {
        if (SelectedCandidateItem is null)
        {
            return;
        }

        GameEquipResult result = Accounts.EquipItem(Session.UserName, MonsterId, SelectedCandidateItem.InstanceId);
        _message = result.Message;
        if (result.Success)
        {
            Quests.ReportEvent(Session.UserName, QuestEventType.EquipItem);
        }
        ReloadAccount();
        CloseEquipmentPopup();
        CloseEquipmentPicker();
    }

    private void InspectCandidateItem(int itemInstanceId)
    {
        _selectedItemId = itemInstanceId;
        _showEquipmentPopup = true;
    }

    private void UnequipSelected()
    {
        if (string.IsNullOrWhiteSpace(_selectedSlotKey))
        {
            return;
        }

        GameEquipResult result = Accounts.UnequipItem(Session.UserName, MonsterId, _selectedSlotKey);
        _message = result.Message;
        ReloadAccount();
        CloseEquipmentPopup();
    }

    private void UpgradeEquippedSlotItem()
    {
        UpgradeEquipmentItem(EquippedSlotItem);
    }

    private void UpgradeSelectedCandidate()
    {
        UpgradeEquipmentItem(SelectedCandidateItem);
    }

    private void UpgradeEquipmentItem(BackpackEquipmentItem? item)
    {
        if (item is null)
        {
            return;
        }

        GameEquipResult result = Accounts.UpgradeEquipment(Session.UserName, item.InstanceId);
        _message = result.Message;
        if (result.Success)
        {
            Quests.ReportEvent(Session.UserName, QuestEventType.UpgradeEquipment);
        }
        ReloadAccount();
    }

    private void OpenLevelUpPopup()
    {
        if (_monster is null)
        {
            return;
        }

        _message = string.Empty;
        _potionCount = Math.Max(1, Math.Min(ExpPotionCount, RequiredPotionCountForNextLevel()));
        _showLevelUpPopup = true;
    }

    private void CloseLevelUpPopup()
    {
        _showLevelUpPopup = false;
    }

    private void ConfirmLevelUp()
    {
        if (_monster is null)
        {
            return;
        }

        GameLevelUpResult result = Accounts.LevelUpMonster(Session.UserName, MonsterId, _potionCount);
        _message = result.Message;
        if (result.Success)
        {
            Quests.ReportEvent(Session.UserName, QuestEventType.MonsterLevelUp);
        }
        ReloadAccount();
        CloseLevelUpPopup();
    }

