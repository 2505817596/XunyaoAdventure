@page "/mail"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject MailStore Mails

<PageTitle>邮箱</PageTitle>

<main class="mail-page">
    <section class="mail-panel">
        @if (_account is null)
        {
            <div class="mail-stage state-only">
                <div class="mail-heading">
                    <h1>邮箱</h1>
                </div>
                <div class="mail-empty-state">请先登录</div>
                <button class="mail-primary-action" @onclick="GoLogin">返回登录</button>
            </div>
        }
        else if (_account.Profile is null)
        {
            <div class="mail-stage state-only">
                <div class="mail-heading">
                    <h1>邮箱</h1>
                </div>
                <div class="mail-empty-state">请先创建角色</div>
                <button class="mail-primary-action" @onclick="GoCreateCharacter">创建角色</button>
            </div>
        }
        else
        {
            <header class="mail-topbar">
                <div class="mail-top-level">等级:@_account.Level</div>
                <div class="mail-top-resource power"><span>信</span><b>@_mails.Count</b></div>
                <div class="mail-top-resource coin"><span>钱</span><b>@_account.Copper</b></div>
                <div class="mail-top-resource gem"><span>战</span><b>@TotalPower</b></div>
                <button class="mail-settings" aria-label="设置" disabled>!</button>
            </header>

            <div class="mail-stage">
                <div class="mail-heading">
                    <h1>邮箱</h1>
                </div>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="@(_success ? "mail-tip" : "mail-message")">@_message</div>
                }

                <div class="mail-actions">
                    <button disabled="@(!CanClaimAll)" @onclick="ClaimAll">一键领取</button>
                </div>

                @if (!_mails.Any())
                {
                    <div class="mail-empty">暂无邮件</div>
                }
                else
                {
                    <div class="mail-list">
                        @foreach (MailMessage mail in _mails)
                        {
                            <article class="mail-item @(mail.Read ? "read" : "") @(mail.Claimed ? "claimed" : "")">
                                <button class="mail-main" @onclick="() => GoDetail(mail.Id)">
                                    <header>
                                        <b>@mail.Title</b>
                                        <span>@ResolveStatus(mail)</span>
                                    </header>
                                    <small>@mail.SenderName / @mail.SentAt.LocalDateTime.ToString("MM-dd HH:mm")</small>
                                    <small>@ResolveAttachmentHint(mail)</small>
                                </button>
                                <button
                                    class="mail-delete"
                                    disabled="@(!CanDelete(mail))"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => Delete(mail.Id)">
                                    删除
                                </button>
                            </article>
                        }
                    </div>
                }
            </div>

            <footer class="mail-bottom-bar">
                <button class="mail-back" @onclick="GoHome">返回</button>
                <button class="active">邮箱</button>
                <button disabled="@(!CanClaimAll)" @onclick="ClaimAll">领取</button>
                <button @onclick="GoHome">主页</button>
            </footer>
        }
    </section>
</main>

@code {
    private PlayerAccount? _account;
    private List<MailMessage> _mails = new();
    private string _message = string.Empty;
    private bool _success;
    private bool CanClaimAll => _mails.Any(mail => mail.Attachments.Count > 0 && !mail.Claimed);

    private int TotalPower
        => _account?.Monsters.Sum(monster => monster.Power) ?? 0;

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        _mails = Mails.GetInbox(Session.UserName).ToList();
    }

    private void GoDetail(long id)
        => Navigation.NavigateTo($"/mail/{id}");

    private void ClaimAll()
    {
        MailClaimAllResult result = Mails.ClaimAllAttachments(Session.UserName);
        _success = result.Success;
        _message = result.Message;
        _account = result.Account ?? _account;
        _mails = result.Mails.ToList();
    }

    private void Delete(long id)
    {
        MailActionResult result = Mails.DeleteMail(Session.UserName, id);
        _success = result.Success;
        _message = result.Message;
        _account = result.Account ?? _account;
        _mails = Mails.GetInbox(Session.UserName).ToList();
    }

    private static bool CanDelete(MailMessage mail)
        => mail.Attachments.Count == 0 || mail.Claimed;

    private static string ResolveStatus(MailMessage mail)
    {
        if (mail.Attachments.Count > 0 && !mail.Claimed)
        {
            return mail.Read ? "可领取" : "未读";
        }

        if (mail.Claimed)
        {
            return "已领取";
        }

        return mail.Read ? "已读" : "未读";
    }

    private static string ResolveAttachmentHint(MailMessage mail)
        => mail.Attachments.Count == 0
            ? "无附件"
            : mail.Claimed
                ? "附件已领取"
                : "有附件";

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoHome()
        => Navigation.NavigateTo("/");
}
