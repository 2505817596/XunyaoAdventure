@page "/battle/formation"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject CampaignStore Campaigns
@inject QuestStore Quests
@inject GameConfigStore Configs

<PageTitle>选择阵容</PageTitle>

<main class="formation-page">
    @if (_account is null)
    {
        <section class="wap-panel">
            <div class="wap-title">选择阵容</div>
            <div class="wap-line">请先登录</div>
            <button class="wap-button" @onclick="GoLogin">返回登录</button>
        </section>
    }
    else if (_account.Profile is null)
    {
        <section class="wap-panel">
            <div class="wap-title">选择阵容</div>
            <div class="wap-line">请先创建角色</div>
            <button class="wap-button" @onclick="GoCreateCharacter">创建角色</button>
        </section>
    }
    else
    {
        <section class="formation-shell">
            <header class="formation-top">
                <div class="formation-title">@ResolveFormationTitle() @_selectedIds.Count/@_initialAccount.FormationSize</div>
                <div class="formation-power">战力 @_selectedPower</div>
            </header>

            @if (Session.SelectedStage is not null)
            {
                <div class="formation-message">
                    @Session.SelectedStage.StageName / 推荐战力 @Session.SelectedStage.RecommendedPower
                </div>
            }
            else if (Session.SelectedArenaBattle is not null)
            {
                <div class="formation-message">
                    竞技场挑战 @Session.SelectedArenaBattle.OpponentRoleName / 战力 @Session.SelectedArenaBattle.OpponentPower
                </div>
            }

            @if (_enemyWaves.Count > 0)
            {
                <section class="enemy-waves" aria-label="敌方阵容">
                    <div class="enemy-waves-head">
                        <div class="enemy-waves-title">敌方阵容</div>
                        <div class="enemy-wave-tabs">
                            @for (int i = 0; i < _enemyWaves.Count; i++)
                            {
                                int waveIndex = i;
                                <button class="enemy-wave-tab @(waveIndex == _selectedEnemyWaveIndex ? "active" : "")"
                                        @onclick="() => SelectEnemyWave(waveIndex)">
                                    第 @_enemyWaves[waveIndex].Index 波
                                </button>
                            }
                        </div>
                    </div>

                    <div class="enemy-wave-stage">
                        @foreach (EnemyWaveView wave in _enemyWaves)
                        {
                            if (wave.Index - 1 == _selectedEnemyWaveIndex)
                            {
                                <div class="enemy-units">
                                    @foreach (EnemyUnitView enemy in wave.Enemies)
                                    {
                                        <div class="enemy-unit @ResolveStageFrameClass(enemy.Stage)" title="@enemy.Name">
                                            <img src="@enemy.PortraitUrl" alt="@enemy.Name" />
                                            <span class="enemy-level">@enemy.Level</span>
                                            <b>@BuildStars(enemy.Star)</b>
                                            <small>@enemy.Name</small>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </section>
            }

            <div class="formation-selected">
                @for (int i = 0; i < _initialAccount.FormationSize; i++)
                {
                    OwnedMonster? monster = i < _selectedMonsters.Count ? _selectedMonsters[i] : null;
                    <button class="formation-slot @(monster is null ? "" : $"filled {ResolveStageFrameClass(monster.Stage)}")" @onclick="() => RemoveAt(i)">
                        @if (monster is null)
                        {
                            <span>+</span>
                        }
                        else
                        {
                            <img src="@monster.PortraitUrl" alt="@monster.Name" />
                            <small>@monster.Level</small>
                            <b>@BuildStars(monster.Star)</b>
                        }
                    </button>
                }
            </div>

            <div class="formation-board">
                <div class="formation-tabs">
                    @foreach (string filter in RosterFilters)
                    {
                        <button class="@(_rosterFilter == filter ? "active" : "")" @onclick="() => SelectRosterFilter(filter)">@filter</button>
                    }
                </div>

                <div class="formation-roster">
                    @foreach (OwnedMonster monster in FilteredRoster)
                    {
                        bool selected = _selectedIds.Contains(monster.Id);
                        <button class="formation-hero @ResolveStageFrameClass(monster.Stage) @(selected ? "selected" : "")" @onclick="() => ToggleMonster(monster.Id)">
                            <img src="@monster.PortraitUrl" alt="@monster.Name" />
                            <small>@monster.Level</small>
                            <b>@BuildStars(monster.Star)</b>
                            @if (selected)
                            {
                                <span>✓</span>
                            }
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="formation-message">@_message</div>
            }

            <footer class="formation-bottom-bar">
                <button class="formation-back" @onclick="GoBack">返回</button>
                <button class="formation-preset" @onclick="SelectDefault">预设阵容</button>
                <button class="formation-fight active" @onclick="StartBattle">战斗</button>
                <button disabled>阵容</button>
            </footer>
        </section>
    }
</main>

@code {
    private static readonly string[] RosterFilters = ["全部", "前", "中", "后", "力", "智", "敏"];
    private PlayerAccount? _account;
    private readonly List<int> _selectedIds = new();
    private readonly List<OwnedMonster> _selectedMonsters = new();
    private readonly List<EnemyWaveView> _enemyWaves = new();
    private InitialAccountConfig _initialAccount = new();
    private int _selectedPower;
    private int _selectedEnemyWaveIndex;
    private string _rosterFilter = "全部";
    private string _message = string.Empty;

    private IEnumerable<OwnedMonster> FilteredRoster
        => (_account?.Monsters ?? Enumerable.Empty<OwnedMonster>())
            .Where(MatchesRosterFilter)
            .OrderBy(monster => ResolvePositionOrder(monster.Position))
            .ThenByDescending(monster => monster.Power);

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        if (_account is null)
        {
            return;
        }

        _initialAccount = Configs.GetInitialAccountConfig();
        if (!Session.IsArenaBattle && !string.IsNullOrWhiteSpace(_initialAccount.DefaultStageId))
        {
            CampaignStageSelection? defaultStage = Campaigns.CreateSelection(Session.UserName, _initialAccount.DefaultStageId);
            if (defaultStage is not null)
            {
                Session.EnsureSelectedStage(defaultStage);
            }
        }

        LoadEnemyWaves();

        foreach (int monsterId in Session.BattleMonsterIds)
        {
            if (_account.Monsters.Any(monster => monster.Id == monsterId))
            {
                _selectedIds.Add(monsterId);
            }
        }

        if (_selectedIds.Count == 0)
        {
            SelectDefault();
            return;
        }

        RefreshSelectedMonsters();
    }

    private void ToggleMonster(int monsterId)
    {
        _message = string.Empty;
        if (_selectedIds.Contains(monsterId))
        {
            _selectedIds.Remove(monsterId);
            RefreshSelectedMonsters();
            return;
        }

        if (_selectedIds.Count >= _initialAccount.FormationSize)
        {
            _message = $"最多选择{_initialAccount.FormationSize}个妖怪";
            return;
        }

        _selectedIds.Add(monsterId);
        RefreshSelectedMonsters();
    }

    private void RemoveAt(int index)
    {
        if (index < 0 || index >= _selectedIds.Count)
        {
            return;
        }

        _selectedIds.RemoveAt(index);
        RefreshSelectedMonsters();
    }

    private void SelectDefault()
    {
        if (_account is null)
        {
            return;
        }

        _message = string.Empty;
        _selectedIds.Clear();
        _selectedIds.AddRange(_account.Monsters
            .OrderByDescending(monster => monster.Power)
            .Take(_initialAccount.FormationSize)
            .Select(monster => monster.Id));
        RefreshSelectedMonsters();
    }

    private void StartBattle()
    {
        if (_selectedIds.Count == 0)
        {
            _message = "请至少选择1个妖怪";
            return;
        }

        Session.SetBattleMonsters(_selectedIds, _initialAccount.FormationSize);
        if (!Session.IsArenaBattle)
        {
            Quests.ReportEvent(Session.UserName, QuestEventType.EnterBattle);
        }

        Navigation.NavigateTo("/battle");
    }

    private void RefreshSelectedMonsters()
    {
        _selectedMonsters.Clear();
        if (_account is null)
        {
            _selectedPower = 0;
            return;
        }

        List<OwnedMonster> sortedMonsters = _selectedIds
            .Select((monsterId, index) => new
            {
                Monster = _account.Monsters.FirstOrDefault(item => item.Id == monsterId),
                Index = index,
            })
            .Where(item => item.Monster is not null)
            .OrderBy(item => ResolvePositionOrder(item.Monster!.Position))
            .ThenBy(item => item.Index)
            .Select(item => item.Monster!)
            .ToList();

        _selectedMonsters.AddRange(sortedMonsters);
        _selectedIds.Clear();
        _selectedIds.AddRange(sortedMonsters.Select(monster => monster.Id));

        _selectedPower = _selectedMonsters.Sum(monster => monster.Power);
    }

    private void LoadEnemyWaves()
    {
        _enemyWaves.Clear();
        if (Session.SelectedArenaBattle is not null)
        {
            _enemyWaves.Add(new EnemyWaveView(
                1,
                Session.SelectedArenaBattle.OpponentFormation
                    .Select(monster => new EnemyUnitView(monster.Name, monster.PortraitUrl, monster.Level, monster.Star, monster.Stage))
                    .ToList()));
            _selectedEnemyWaveIndex = 0;
            return;
        }

        if (Session.SelectedStage is null)
        {
            return;
        }

        CampaignStageConfig? stage = Configs.GetCampaignStage(Session.SelectedStage.StageId);
        if (stage is null)
        {
            return;
        }

        for (int i = 0; i < stage.Waves.Count; i++)
        {
            List<EnemyUnitView> enemies = stage.Waves[i].Enemies
                .Select(ToEnemyUnitView)
                .ToList();
            if (enemies.Count > 0)
            {
                _enemyWaves.Add(new EnemyWaveView(i + 1, enemies));
            }
        }

        _selectedEnemyWaveIndex = Math.Clamp(_selectedEnemyWaveIndex, 0, Math.Max(0, _enemyWaves.Count - 1));
    }

    private void SelectEnemyWave(int waveIndex)
        => _selectedEnemyWaveIndex = Math.Clamp(waveIndex, 0, Math.Max(0, _enemyWaves.Count - 1));

    private void SelectRosterFilter(string filter)
        => _rosterFilter = filter;

    private bool MatchesRosterFilter(OwnedMonster monster)
        => _rosterFilter switch
        {
            "前" => IsPosition(monster.Position, "前"),
            "中" => IsPosition(monster.Position, "中"),
            "后" => IsPosition(monster.Position, "后"),
            "力" => IsAttribute(monster.Attribute, "力"),
            "智" => IsAttribute(monster.Attribute, "智"),
            "敏" => IsAttribute(monster.Attribute, "敏"),
            _ => true,
        };

    private EnemyUnitView ToEnemyUnitView(CampaignEnemyConfig enemy)
    {
        MonsterTemplateConfig? template = Configs.GetMonsterTemplate(enemy.TemplateId);
        string name = string.IsNullOrWhiteSpace(enemy.Name)
            ? template?.Name ?? enemy.TemplateId
            : enemy.Name;
        return new EnemyUnitView(
            name,
            template?.PortraitUrl ?? "/battle-client/unit/001/stand/0000.png",
            Math.Clamp(enemy.Level, 1, GameAccountStore.MaxMonsterLevel),
            Math.Clamp(enemy.Star, 1, GameAccountStore.MaxMonsterStar),
            Math.Clamp(enemy.Stage, 1, GameAccountStore.MaxMonsterStage));
    }

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoBack()
    {
        if (Session.IsArenaBattle)
        {
            Session.ClearArenaBattle();
            Navigation.NavigateTo("/arena");
            return;
        }

        Session.ClearSelectedStage();
        Navigation.NavigateTo("/");
    }

    private string ResolveFormationTitle()
        => Session.SelectedArenaBattle is not null
            ? "竞技场"
            : Session.SelectedStage?.StageCode ?? "阵容";

    private static string BuildStars(int star)
        => new('★', Math.Clamp(star, 1, GameAccountStore.MaxMonsterStar));

    private static string ResolveStageFrameClass(int stage)
        => $"stage-{Math.Clamp(stage, 1, GameAccountStore.MaxMonsterStage)}";

    private static int ResolvePositionOrder(string position)
    {
        if (position == "中排" || position.Contains('中'))
        {
            return 1;
        }

        if (position == "后排" || position.Contains('后'))
        {
            return 2;
        }

        return 0;
    }

    private static bool IsPosition(string position, string key)
        => !string.IsNullOrWhiteSpace(position) && position.Contains(key, StringComparison.Ordinal);

    private static bool IsAttribute(string attribute, string key)
        => !string.IsNullOrWhiteSpace(attribute) && attribute.Contains(key, StringComparison.Ordinal);

    private sealed record EnemyWaveView(int Index, IReadOnlyList<EnemyUnitView> Enemies);

    private sealed record EnemyUnitView(string Name, string PortraitUrl, int Level, int Star, int Stage);
}
