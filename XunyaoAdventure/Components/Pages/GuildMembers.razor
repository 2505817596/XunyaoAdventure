@page "/guild/members"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject GuildStore GuildService

<PageTitle>公会成员</PageTitle>

<main class="wap-page guild-page">
    <section class="wap-panel guild-panel">
        <div class="wap-title">公会成员</div>

        @if (_account is null)
        {
            <div class="wap-line">请先登录</div>
            <button class="wap-button" @onclick="GoLogin">返回登录</button>
        }
        else if (_account.Profile is null)
        {
            <div class="wap-line">请先创建角色</div>
            <button class="wap-button" @onclick="GoCreateCharacter">创建角色</button>
        }
        else if (_guild is null)
        {
            <div class="wap-line">你还没有加入公会</div>
            <footer class="guild-bottom-bar">
                <button class="guild-back" @onclick="GoHome">返回</button>
            </footer>
        }
        else
        {
            <div class="guild-header">
                <b>@_guild.Name</b>
                <span>@_guild.Level 级 / @_guild.Members.Count 人</span>
            </div>

            <div class="guild-member-list">
                @foreach (GuildMember member in OrderedMembers)
                {
                    <article class="guild-member">
                        <div>
                            <b>@member.RoleName</b>
                            <small>@member.UserName / 贡献 @member.Contribution</small>
                        </div>
                        <span>@ResolveRoleName(member.Role)</span>
                    </article>
                }
            </div>

            <footer class="guild-bottom-bar">
                <button class="guild-back" @onclick="GoGuild">返回</button>
            </footer>
        }
    </section>
</main>

@code {
    private PlayerAccount? _account;
    private XunyaoAdventure.Game.Guild? _guild;

    private IEnumerable<GuildMember> OrderedMembers
        => _guild?.Members
            .OrderBy(member => member.Role)
            .ThenByDescending(member => member.Contribution)
            .ThenBy(member => member.JoinedAt)
            ?? Enumerable.Empty<GuildMember>();

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        _guild = GuildService.GetGuildByMember(Session.UserName);
    }

    private static string ResolveRoleName(GuildMemberRole role)
        => role == GuildMemberRole.Leader ? "会长" : "成员";

    private void GoGuild()
        => Navigation.NavigateTo("/guild");

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoHome()
        => Navigation.NavigateTo("/");
}
