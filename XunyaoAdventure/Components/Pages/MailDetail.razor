@page "/mail/{MailId:long}"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject MailStore Mails

<PageTitle>邮件详情</PageTitle>

<main class="mail-detail-page">
    <section class="mail-detail-panel">
        @if (_account is null)
        {
            <div class="mail-detail-stage state-only">
                <div class="mail-detail-heading">
                    <h1>邮件详情</h1>
                </div>
                <div class="mail-detail-empty-state">请先登录</div>
                <button class="mail-detail-primary-action" @onclick="GoLogin">返回登录</button>
            </div>
        }
        else if (_account.Profile is null)
        {
            <div class="mail-detail-stage state-only">
                <div class="mail-detail-heading">
                    <h1>邮件详情</h1>
                </div>
                <div class="mail-detail-empty-state">请先创建角色</div>
                <button class="mail-detail-primary-action" @onclick="GoCreateCharacter">创建角色</button>
            </div>
        }
        else if (_mail is null)
        {
            <div class="mail-detail-stage state-only">
                <div class="mail-detail-heading">
                    <h1>邮件详情</h1>
                </div>
                <div class="mail-detail-empty-state">邮件不存在</div>
                <button class="mail-detail-primary-action" @onclick="GoMail">返回邮箱</button>
            </div>
        }
        else
        {
            <header class="mail-detail-topbar">
                <div class="mail-detail-top-level">等级:@_account.Level</div>
                <div class="mail-detail-top-resource power"><span>附</span><b>@_mail.Attachments.Count</b></div>
                <div class="mail-detail-top-resource coin"><span>钱</span><b>@_account.Copper</b></div>
                <div class="mail-detail-top-resource gem"><span>战</span><b>@TotalPower</b></div>
                <button class="mail-detail-settings" aria-label="设置" disabled>!</button>
            </header>

            <div class="mail-detail-stage">
                <div class="mail-detail-heading">
                    <h1>邮件详情</h1>
                </div>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="@(_success ? "mail-detail-tip" : "mail-detail-message")">@_message</div>
                }

                <div class="mail-detail-scroll">
                    <section class="mail-detail-card">
                        <header>
                            <b>@_mail.Title</b>
                            <span>@_mail.SenderName</span>
                        </header>
                        <small>@_mail.SentAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</small>
                        <p>@_mail.Content</p>
                    </section>

                    <section class="mail-detail-card">
                        <header>
                            <b>附件</b>
                            <span>@ResolveAttachmentStatus()</span>
                        </header>
                        <div class="mail-rewards">
                            @(_mail.Attachments.Any() ? RewardText(_mail.Attachments) : "无附件")
                        </div>
                    </section>
                </div>
            </div>

            <footer class="mail-detail-bottom-bar">
                <button class="mail-detail-back" @onclick="GoMail">返回</button>
                <button class="active" disabled="@_mail.Claimed" @onclick="Claim">领取</button>
                <button disabled="@(!CanDelete())" @onclick="Delete">删除</button>
                <button @onclick="GoMail">邮箱</button>
            </footer>
        }
    </section>
</main>

@code {
    [Parameter]
    public long MailId { get; set; }

    private PlayerAccount? _account;
    private MailMessage? _mail;
    private string _message = string.Empty;
    private bool _success;

    private int TotalPower
        => _account?.Monsters.Sum(monster => monster.Power) ?? 0;

    protected override void OnParametersSet()
    {
        _account = Accounts.GetAccount(Session.UserName);
        if (_account is null)
        {
            return;
        }

        MailActionResult result = Mails.MarkRead(Session.UserName, MailId);
        _mail = result.Mail ?? Mails.GetMail(Session.UserName, MailId);
        if (!result.Success)
        {
            _success = false;
            _message = result.Message;
        }
    }

    private void Claim()
    {
        MailActionResult result = Mails.ClaimAttachments(Session.UserName, MailId);
        _success = result.Success;
        _message = result.Message;
        _account = result.Account ?? _account;
        _mail = result.Mail ?? Mails.GetMail(Session.UserName, MailId);
    }

    private void Delete()
    {
        MailActionResult result = Mails.DeleteMail(Session.UserName, MailId);
        _success = result.Success;
        _message = result.Message;
        _account = result.Account ?? _account;
        if (result.Success)
        {
            GoMail();
            return;
        }

        _mail = result.Mail ?? Mails.GetMail(Session.UserName, MailId);
    }

    private bool CanDelete()
        => _mail is not null && (_mail.Attachments.Count == 0 || _mail.Claimed);

    private string ResolveAttachmentStatus()
    {
        if (_mail is null || !_mail.Attachments.Any())
        {
            return "无附件";
        }

        return _mail.Claimed ? "已领取" : "可领取";
    }

    private static string RewardText(IReadOnlyList<QuestReward> rewards)
        => string.Join(" / ", rewards.Select(reward => $"{reward.Name} x{reward.Quantity}"));

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoMail()
        => Navigation.NavigateTo("/mail");
}
