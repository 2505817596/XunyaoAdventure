@page "/campaign/{ChapterId}"
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject CampaignStore Campaigns
@inject QuestStore Quests
@inject GameConfigStore Configs

<PageTitle>章节</PageTitle>

<main class="campaign-page">
    <section class="campaign-panel">
        @if (_account is null)
        {
            <div class="campaign-stage state-only">
                <div class="campaign-heading">
                    <h1>章节</h1>
                </div>
                <div class="campaign-empty-state">请先登录</div>
                <button class="campaign-primary-action" @onclick="GoLogin">返回登录</button>
            </div>
        }
        else if (_account.Profile is null)
        {
            <div class="campaign-stage state-only">
                <div class="campaign-heading">
                    <h1>章节</h1>
                </div>
                <div class="campaign-empty-state">请先创建角色</div>
                <button class="campaign-primary-action" @onclick="GoCreateCharacter">创建角色</button>
            </div>
        }
        else if (_chapter is null)
        {
            <div class="campaign-stage state-only">
                <div class="campaign-heading">
                    <h1>章节</h1>
                </div>
                <div class="campaign-empty-state">章节不存在</div>
                <button class="campaign-primary-action" @onclick="GoCampaign">返回副本</button>
            </div>
        }
        else if (!_chapter.Unlocked)
        {
            <div class="campaign-stage state-only">
                <div class="campaign-heading">
                    <h1>@_chapter.Name</h1>
                </div>
                <div class="campaign-empty-state">该章节尚未开放</div>
                <button class="campaign-primary-action" @onclick="GoCampaign">返回副本</button>
            </div>
        }
        else
        {
            <header class="campaign-topbar">
                <div class="campaign-top-level">等级:@_account.Level</div>
                <div class="campaign-top-resource power"><span>关</span><b>@_stages.Count</b></div>
                <div class="campaign-top-resource coin"><span>通</span><b>@ClearedStageCount</b></div>
                <div class="campaign-top-resource gem"><span>战</span><b>@TotalPower</b></div>
                <button class="campaign-settings" aria-label="设置" disabled>!</button>
            </header>

            <div class="campaign-stage">
                <div class="campaign-heading">
                    <h1>@_chapter.Name</h1>
                </div>

                <div class="chapter-description">@_chapter.Description</div>

                <div class="stage-list">
                    @foreach (CampaignStageView stageView in _stages)
                    {
                        CampaignStage stage = stageView.Stage;
                        IReadOnlyList<StageEnemyPreview> lastWaveEnemies = GetLastWaveEnemies(stage.Id);
                        <article class="stage-item @(stageView.Unlocked ? "" : "locked") @(stageView.Cleared ? "cleared" : "")">
                            <div class="stage-main">
                                <header>
                                    <b>@stage.Code @stage.Name</b>
                                    <span>推荐战力 @stage.RecommendedPower</span>
                                </header>
                                <p>@stage.Description</p>
                                @if (lastWaveEnemies.Count > 0)
                                {
                                    <div class="stage-enemies" aria-label="最后一波敌方妖怪">
                                        <span class="stage-enemies-label">末波</span>
                                        @foreach (StageEnemyPreview enemy in lastWaveEnemies)
                                        {
                                            <div class="stage-enemy @ResolveStageFrameClass(enemy.Stage)" title="@enemy.Name">
                                                <img src="@enemy.PortraitUrl" alt="@enemy.Name" />
                                                <span>@enemy.Level</span>
                                                <b>@BuildStars(enemy.Star)</b>
                                            </div>
                                        }
                                    </div>
                                }
                                <small>难度 @stage.Difficulty / @ResolveStageStatus(stageView)</small>
                            </div>
                            <div class="stage-actions">
                                <button disabled="@(!stageView.Unlocked)" @onclick="() => Challenge(stage.Id)">
                                    @(stageView.Unlocked ? "挑战" : "锁定")
                                </button>
                                @if (stageView.Cleared)
                                {
                                    <button class="sweep" @onclick="() => Sweep(stage.Id)">扫荡</button>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>

            <footer class="campaign-bottom-bar">
                <button class="campaign-back" @onclick="GoCampaign">返回</button>
                <button class="active">章节</button>
                <button disabled>关卡</button>
                <button disabled>扫荡</button>
            </footer>
        }
    </section>
</main>

@code {
    [Parameter]
    public string ChapterId { get; set; } = string.Empty;

    private PlayerAccount? _account;
    private CampaignChapterDefinition? _chapter;
    private IReadOnlyList<CampaignStageView> _stages = Array.Empty<CampaignStageView>();
    private readonly Dictionary<string, IReadOnlyList<StageEnemyPreview>> _lastWaveEnemies = new(StringComparer.OrdinalIgnoreCase);

    private int TotalPower
        => _account?.Monsters.Sum(monster => monster.Power) ?? 0;

    private int ClearedStageCount
        => _stages.Count(stage => stage.Cleared);

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        _chapter = Campaigns.GetChapter(ChapterId);
        _stages = Campaigns.GetStageViews(Session.UserName, ChapterId);
        LoadStageEnemyPreviews();
    }

    private void Challenge(string stageId)
    {
        CampaignStageSelection? selection = Campaigns.CreateSelection(Session.UserName, stageId);
        if (selection is null)
        {
            return;
        }

        Session.SelectStage(selection);
        Navigation.NavigateTo("/battle/formation");
    }

    private void Sweep(string stageId)
    {
        CampaignBattleResult? result = Campaigns.SweepStage(Session.UserName, stageId, Accounts);
        if (result is null)
        {
            return;
        }

        Quests.ReportEvent(Session.UserName, QuestEventType.ClearStage);
        Session.SetBattleResult(result);
        Navigation.NavigateTo("/battle/result");
    }

    private void LoadStageEnemyPreviews()
    {
        _lastWaveEnemies.Clear();
        foreach (CampaignStageConfig stage in Configs.GetCampaignStages())
        {
            CampaignEnemyWaveConfig? lastWave = stage.Waves.LastOrDefault(wave => wave.Enemies.Count > 0);
            if (lastWave is null)
            {
                continue;
            }

            _lastWaveEnemies[stage.Id] = lastWave.Enemies
                .Select(ToStageEnemyPreview)
                .ToList();
        }
    }

    private IReadOnlyList<StageEnemyPreview> GetLastWaveEnemies(string stageId)
        => _lastWaveEnemies.TryGetValue(stageId, out IReadOnlyList<StageEnemyPreview>? enemies)
            ? enemies
            : Array.Empty<StageEnemyPreview>();

    private StageEnemyPreview ToStageEnemyPreview(CampaignEnemyConfig enemy)
    {
        MonsterTemplateConfig? template = Configs.GetMonsterTemplate(enemy.TemplateId);
        string name = string.IsNullOrWhiteSpace(enemy.Name)
            ? template?.Name ?? enemy.TemplateId
            : enemy.Name;
        return new StageEnemyPreview(
            name,
            template?.PortraitUrl ?? "/battle-client/unit/001/stand/0000.png",
            Math.Clamp(enemy.Level, 1, GameAccountStore.MaxMonsterLevel),
            Math.Clamp(enemy.Star, 1, GameAccountStore.MaxMonsterStar),
            Math.Clamp(enemy.Stage, 1, GameAccountStore.MaxMonsterStage));
    }

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoCampaign()
        => Navigation.NavigateTo("/campaign");

    private static string ResolveStageStatus(CampaignStageView stageView)
    {
        if (stageView.Cleared)
        {
            return "已通关";
        }

        return stageView.Unlocked ? "未通关" : "未解锁";
    }

    private static string BuildStars(int star)
        => new('★', Math.Clamp(star, 1, GameAccountStore.MaxMonsterStar));

    private static string ResolveStageFrameClass(int stage)
        => $"stage-{Math.Clamp(stage, 1, GameAccountStore.MaxMonsterStage)}";

    private sealed record StageEnemyPreview(string Name, string PortraitUrl, int Level, int Star, int Stage);
}
