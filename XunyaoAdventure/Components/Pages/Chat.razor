@page "/chat"
@page "/chat/{FriendUserName}"
@implements IDisposable
@inject NavigationManager Navigation
@inject GameSession Session
@inject GameAccountStore Accounts
@inject ChatStore Chats
@inject QuestStore Quests
@inject GuildStore GuildService
@inject FriendStore FriendService

<PageTitle>聊天</PageTitle>

<main class="wap-page chat-page">
    <section class="wap-panel chat-panel">
        <div class="wap-title">聊天</div>

        @if (_account is null)
        {
            <div class="wap-line">请先登录</div>
            <button class="wap-button" @onclick="GoLogin">返回登录</button>
        }
        else if (_account.Profile is null)
        {
            <div class="wap-line">请先创建角色</div>
            <button class="wap-button" @onclick="GoCreateCharacter">创建角色</button>
        }
        else
        {
            <div class="chat-tabs">
                <button class="@TabClass(ChatChannel.Direct)" @onclick="() => SelectChannel(ChatChannel.Direct)">私聊</button>
                <button class="@TabClass(ChatChannel.World)" @onclick="() => SelectChannel(ChatChannel.World)">世界</button>
                <button class="@TabClass(ChatChannel.Guild)" @onclick="() => SelectChannel(ChatChannel.Guild)">公会</button>
                <button class="@TabClass(ChatChannel.System)" @onclick="() => SelectChannel(ChatChannel.System)">系统</button>
            </div>

            @if (_channel == ChatChannel.Guild && _guild is null)
            {
                <div class="wap-line">你还没有加入公会</div>
                <button class="wap-button" @onclick="GoGuilds">查找公会</button>
            }
            else if (_channel == ChatChannel.Direct && _directFriend is null)
            {
                <div class="wap-line">请选择好友进行私聊</div>
                <button class="wap-button" @onclick="GoFriends">好友列表</button>
            }
            else
            {
                @if (_channel == ChatChannel.Direct && _directFriend is not null)
                {
                    <div class="chat-direct-header">
                        <span>正在私聊</span>
                        <b>@_directFriend.DisplayName</b>
                        <button @onclick="GoFriends">切换</button>
                    </div>
                }

                <div class="chat-list">
                    @if (_messages.Count == 0)
                    {
                        <div class="chat-empty">暂无消息</div>
                    }
                    else
                    {
                        @foreach (ChatMessage message in _messages)
                        {
                            bool isMine = message.SenderUserName == _account.UserName;
                            @if (message.IsSystem)
                            {
                                <article class="chat-system-message">
                                    <span>@message.Content</span>
                                </article>
                            }
                            else
                            {
                                <article class="chat-message @(isMine ? "mine" : "")">
                                    @if (!isMine)
                                    {
                                        <div class="chat-avatar">@GetAvatarText(message.SenderDisplayName)</div>
                                    }
                                    <div class="chat-bubble-wrap">
                                        <header>
                                            <b>@message.SenderDisplayName</b>
                                            <span>@FormatTime(message.SentAt)</span>
                                        </header>
                                        <p>@message.Content</p>
                                    </div>
                                    @if (isMine)
                                    {
                                        <div class="chat-avatar">@GetAvatarText(message.SenderDisplayName)</div>
                                    }
                                </article>
                            }
                        }
                    }
                </div>

                @if (_channel != ChatChannel.System)
                {
                    <div class="chat-compose">
                        <input maxlength="@ChatStore.MaxMessageLength" placeholder="输入聊天内容" @bind="_draft" @bind:event="oninput" @onkeydown="HandleKeyDown" />
                        <button disabled="@string.IsNullOrWhiteSpace(_draft)" @onclick="SendMessage">发送</button>
                    </div>
                    <div class="chat-count">@_draft.Trim().Length / @ChatStore.MaxMessageLength</div>
                }
                else
                {
                    <div class="chat-readonly">系统频道只显示公告</div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="wap-message">@_message</div>
            }
            <footer class="chat-bottom-bar">
                <button class="chat-back" @onclick="GoHome">返回</button>
                <button class="@TabClass(ChatChannel.Direct)" @onclick="() => SelectChannel(ChatChannel.Direct)">私聊</button>
                <button class="@TabClass(ChatChannel.World)" @onclick="() => SelectChannel(ChatChannel.World)">世界</button>
                <button class="@TabClass(ChatChannel.Guild)" @onclick="() => SelectChannel(ChatChannel.Guild)">公会</button>
            </footer>
        }
    </section>
</main>

@code {
    [Parameter]
    public string? FriendUserName { get; set; }

    private PlayerAccount? _account;
    private XunyaoAdventure.Game.Guild? _guild;
    private FriendProfile? _directFriend;
    private ChatChannel _channel = ChatChannel.World;
    private List<ChatMessage> _messages = new();
    private string _draft = string.Empty;
    private string _message = string.Empty;

    private string ComposePlaceholder
        => _channel == ChatChannel.Direct && _directFriend is not null
            ? $"发送给 {_directFriend.DisplayName}"
            : "输入聊天内容";

    protected override void OnInitialized()
    {
        _account = Accounts.GetAccount(Session.UserName);
        _guild = GuildService.GetGuildByMember(Session.UserName);
        Chats.MessagesChanged += OnMessagesChanged;
        FriendService.FriendsChanged += OnFriendsChanged;
        ResolveDirectFriend();
        RefreshMessages(markDirectRead: true);
    }

    protected override void OnParametersSet()
    {
        ResolveDirectFriend();
        if (!string.IsNullOrWhiteSpace(FriendUserName))
        {
            _channel = ChatChannel.Direct;
        }

        RefreshMessages(markDirectRead: true);
    }

    private void SelectChannel(ChatChannel channel)
    {
        _channel = channel;
        _message = string.Empty;
        ResolveDirectFriend();
        RefreshMessages(markDirectRead: channel == ChatChannel.Direct);
    }

    private void SendMessage()
    {
        ChatSendResult result = _channel switch
        {
            ChatChannel.Guild => Chats.SendGuildMessage(_account, _guild, _draft),
            ChatChannel.Direct => Chats.SendDirectMessage(_account, _directFriend?.UserName, _draft),
            _ => Chats.SendWorldMessage(_account, _draft),
        };

        _message = result.Success ? string.Empty : result.Message;
        if (result.Success)
        {
            _draft = string.Empty;
            Quests.ReportEvent(Session.UserName, QuestEventType.SendChat);
        }

        _account = Accounts.GetAccount(Session.UserName);
        _guild = GuildService.GetGuildByMember(Session.UserName);
        ResolveDirectFriend();
        RefreshMessages(markDirectRead: result.Success);
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_draft) && _channel != ChatChannel.System)
        {
            SendMessage();
        }
    }

    private void RefreshMessages(bool markDirectRead = false)
    {
        _messages = _channel == ChatChannel.Direct
            ? Chats.GetDirectMessages(Session.UserName, _directFriend?.UserName).ToList()
            : Chats.GetMessages(_channel, _guild?.Id).ToList();

        if (markDirectRead && _channel == ChatChannel.Direct && _directFriend is not null)
        {
            Chats.MarkDirectChatRead(Session.UserName, _directFriend.UserName);
        }
    }

    private void OnMessagesChanged()
    {
        _ = InvokeAsync(() =>
        {
            _guild = GuildService.GetGuildByMember(Session.UserName);
            ResolveDirectFriend();
            RefreshMessages(markDirectRead: _channel == ChatChannel.Direct);
            StateHasChanged();
        });
    }

    private void OnFriendsChanged()
    {
        _ = InvokeAsync(() =>
        {
            ResolveDirectFriend();
            RefreshMessages(markDirectRead: _channel == ChatChannel.Direct);
            StateHasChanged();
        });
    }

    private void ResolveDirectFriend()
    {
        if (string.IsNullOrWhiteSpace(FriendUserName))
        {
            _directFriend = null;
            return;
        }

        string decoded = Uri.UnescapeDataString(FriendUserName);
        _directFriend = FriendService.GetFriends(Session.UserName)
            .FirstOrDefault(friend => string.Equals(friend.UserName, decoded, StringComparison.OrdinalIgnoreCase));
    }

    private string TabClass(ChatChannel channel)
        => _channel == channel ? "active" : string.Empty;

    private void GoLogin()
        => Navigation.NavigateTo("/login");

    private void GoCreateCharacter()
        => Navigation.NavigateTo("/create-character");

    private void GoGuilds()
        => Navigation.NavigateTo("/guilds");

    private void GoFriends()
        => Navigation.NavigateTo("/friends");

    private void GoHome()
        => Navigation.NavigateTo("/");

    private static string FormatTime(DateTimeOffset sentAt)
        => sentAt.ToLocalTime().ToString("HH:mm");

    private static string GetAvatarText(string displayName)
    {
        string text = string.IsNullOrWhiteSpace(displayName) ? "妖" : displayName.Trim();
        return text[..1];
    }

    public void Dispose()
    {
        Chats.MessagesChanged -= OnMessagesChanged;
        FriendService.FriendsChanged -= OnFriendsChanged;
    }
}
